rules_version = '2';

// Security Rules — docs/DATA_MODEL.md §7.
// La seguridad real del sistema está aquí, no en la interfaz.
// Cada colección se habilita en la fase que la construye, con su propia validación.
service cloud.firestore {
  match /databases/{database}/documents {

    // Único administrador autorizado (D-000). Debe coincidir con VITE_ADMIN_UID.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'JnLYZuNYe8Vjuvf8TEu7rmTP1nh2';
    }

    function isInt(v) { return v is int; }
    function isNonNegInt(v) { return v is int && v >= 0; }
    function isText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optNonNegInt(v) { return v == null || isNonNegInt(v); }

    // Deniega todo por defecto.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- Configuración
    match /settings/{docId} {
      allow read: if isAdmin() && docId == 'general';
      allow create, update: if isAdmin() && docId == 'general' && validSettings(request.resource.data);
      allow delete: if false;
    }

    function validSettings(d) {
      return d.keys().hasOnly(['businessName', 'globalMarkupBp', 'roundingStep', 'defaultMinStock',
          'nearMinFactorBp', 'targetStockFactorBp', 'supplierLeadDays', 'safetyDays',
          'discountCapBp', 'reportEmail', 'updatedAt'])
        && (!('businessName' in d) || isText(d.businessName, 1, 80))
        && (!('globalMarkupBp' in d) || (isNonNegInt(d.globalMarkupBp) && d.globalMarkupBp <= 100000))
        && (!('roundingStep' in d) || d.roundingStep in [50, 100, 500, 1000])
        && (!('defaultMinStock' in d) || isNonNegInt(d.defaultMinStock))
        && (!('nearMinFactorBp' in d) || (isInt(d.nearMinFactorBp) && d.nearMinFactorBp >= 10000))
        && (!('targetStockFactorBp' in d) || (isInt(d.targetStockFactorBp) && d.targetStockFactorBp >= 10000))
        && (!('supplierLeadDays' in d) || isNonNegInt(d.supplierLeadDays))
        && (!('safetyDays' in d) || isNonNegInt(d.safetyDays))
        && (!('discountCapBp' in d) || (isNonNegInt(d.discountCapBp) && d.discountCapBp <= 10000))
        && (!('reportEmail' in d) || d.reportEmail == null || isText(d.reportEmail, 3, 120))
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // ---------------------------------------------------------------- Categorías (Fase 2)
    // No se borran: se desactivan.
    match /categories/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validCategory(request.resource.data);
      allow delete: if false;
    }

    function validCategory(d) {
      return d.keys().hasOnly(['name', 'icon', 'active', 'sortOrder'])
        && isText(d.name, 1, 40)
        && isText(d.icon, 1, 30)
        && d.active is bool
        && isInt(d.sortOrder);
    }

    // ---------------------------------------------------------------- Productos (Fase 2)
    // Stock nunca negativo. En la Fase 2 el stock nace en 0 y no se edita desde el catálogo;
    // el costo solo se edita a mano mientras no haya stock (D-105). No se borran (se desactivan).
    match /products/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validProduct(request.resource.data)
        && request.resource.data.stock == 0
        && request.resource.data.get('lastMovementId', null) == null;
      // Dos caminos de edición:
      //  1) Catálogo: no toca stock ni último movimiento; el costo solo si no hay stock.
      //  2) Inventario (R-INV-01): stock y costo cambian SOLO junto a un movimiento nuevo que cuadra.
      allow update: if isAdmin() && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (catalogEdit(id) || inventoryEdit(id));
      allow delete: if false;
    }

    function catalogEdit(id) {
      return request.resource.data.stock == resource.data.stock
        && request.resource.data.get('lastMovementId', null) == resource.data.get('lastMovementId', null)
        && (request.resource.data.avgCost == resource.data.avgCost || resource.data.stock == 0);
    }

    function inventoryEdit(id) {
      let movId = request.resource.data.get('lastMovementId', null);
      let movPath = /databases/$(database)/documents/inventoryMovements/$(movId);
      let mov = getAfter(movPath).data;
      return movId is string
        && movId != resource.data.get('lastMovementId', null)
        && !exists(movPath)
        && mov.productId == id
        && mov.stockBefore == resource.data.stock
        && mov.stockAfter == request.resource.data.stock
        && mov.avgCostBefore == resource.data.avgCost
        && mov.avgCostAfter == request.resource.data.avgCost;
    }

    function validProduct(d) {
      return d.keys().hasOnly(['name', 'description', 'categoryId', 'unit', 'stock', 'minStock',
          'avgCost', 'lastPurchaseCost', 'salePrice', 'pricingMode', 'markupBp', 'active',
          'lastMovementId', 'createdAt', 'updatedAt'])
        && isText(d.name, 1, 80)
        && d.description is string && d.description.size() <= 300
        && isText(d.categoryId, 1, 60)
        && d.unit in ['unidad', 'botella', 'media botella', 'lata', 'paquete', 'vaso', 'otro']
        && isNonNegInt(d.stock)
        && isNonNegInt(d.minStock)
        && isNonNegInt(d.avgCost)
        && isNonNegInt(d.lastPurchaseCost)
        && isNonNegInt(d.salePrice)
        && d.pricingMode in ['auto', 'manual']
        && (d.markupBp == null || (isNonNegInt(d.markupBp) && d.markupBp <= 1000000))
        && d.active is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    // ---------------------------------------------------------------- Movimientos (Fase 3)
    // Inmutables. Cada uno debe coincidir con el estado real del producto antes y después
    // del commit, y el producto debe apuntar a él (lastMovementId). Stock nunca negativo.
    match /inventoryMovements/{movId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validMovement(movId, request.resource.data);
      allow update, delete: if false;
    }

    function validMovement(movId, d) {
      let productPath = /databases/$(database)/documents/products/$(d.productId);
      let before = get(productPath).data;
      let after = getAfter(productPath).data;
      return d.keys().hasOnly(['productId', 'productName', 'type', 'qty', 'stockBefore',
          'stockAfter', 'avgCostBefore', 'avgCostAfter', 'unitCost', 'sourceType', 'sourceId',
          'reason', 'businessDate', 'uid', 'createdAt'])
        && isText(d.productId, 1, 60)
        && d.productName is string
        && d.type in ['entrada_inicial', 'entrada_manual', 'entrada_compra', 'venta',
          'cancelacion_item', 'anulacion_venta', 'merma', 'danado', 'vencido', 'cortesia',
          'consumo_propio', 'ajuste_positivo', 'ajuste_negativo', 'conteo']
        && isInt(d.qty) && d.qty != 0
        && signMatches(d.type, d.qty)
        && isNonNegInt(d.stockBefore) && isNonNegInt(d.stockAfter)
        && d.stockAfter == d.stockBefore + d.qty
        && isNonNegInt(d.avgCostBefore) && isNonNegInt(d.avgCostAfter) && isNonNegInt(d.unitCost)
        && d.sourceType in ['ajuste', 'conteo', 'venta', 'compra']
        && isText(d.sourceId, 1, 120)
        && (d.reason == null || isText(d.reason, 3, 200))
        && (!reasonRequired(d.type) || d.reason != null)
        && d.businessDate is string && d.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.uid == request.auth.uid
        && d.createdAt == request.time
        && before.stock == d.stockBefore
        && after.stock == d.stockAfter
        && after.lastMovementId == movId;
    }

    function signMatches(type, qty) {
      return type == 'conteo'
        || (type in ['entrada_inicial', 'entrada_manual', 'entrada_compra', 'cancelacion_item',
              'anulacion_venta', 'ajuste_positivo'] && qty > 0)
        || (type in ['venta', 'merma', 'danado', 'vencido', 'cortesia', 'consumo_propio',
              'ajuste_negativo'] && qty < 0);
    }

    function reasonRequired(type) {
      return type in ['merma', 'danado', 'vencido', 'cortesia', 'consumo_propio',
        'ajuste_negativo', 'ajuste_positivo', 'conteo'];
    }

    // ---------------------------------------------------------------- Historial de precios
    // Inmutable: solo se crea, y solo para productos que existen (o se crean en el mismo batch).
    match /priceHistory/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validPriceHistory(request.resource.data)
        && existsAfter(/databases/$(database)/documents/products/$(request.resource.data.productId));
      allow update, delete: if false;
    }

    function validPriceHistory(d) {
      return d.keys().hasOnly(['productId', 'field', 'oldValue', 'newValue', 'source', 'reason', 'at'])
        && isText(d.productId, 1, 60)
        && d.field in ['salePrice', 'avgCost', 'markupBp']
        && optNonNegInt(d.oldValue)
        && optNonNegInt(d.newValue)
        && d.source in ['creacion', 'manual', 'recalculo', 'importacion', 'recepcion', 'ajuste']
        && (d.reason == null || isText(d.reason, 1, 200))
        && d.at == request.time;
    }

    // ---------------------------------------------------------------- Auditoría
    // Inmutable. El UID debe ser el de quien escribe y la fecha la del servidor.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAudit(request.resource.data);
      allow update, delete: if false;
    }

    function validAudit(d) {
      return d.keys().hasOnly(['action', 'entity', 'entityId', 'summary', 'before', 'after',
          'reason', 'uid', 'at'])
        && isText(d.action, 1, 40)
        && isText(d.entity, 1, 40)
        && isText(d.entityId, 1, 120)
        && isText(d.summary, 1, 300)
        && (d.before == null || d.before is map)
        && (d.after == null || d.after is map)
        && (d.reason == null || isText(d.reason, 1, 300))
        && d.uid == request.auth.uid
        && d.at == request.time;
    }
  }
}
