rules_version = '2';

// Security Rules — docs/DATA_MODEL.md §7.
// La seguridad real del sistema está aquí, no en la interfaz.
// Cada colección se habilita en la fase que la construye, con su propia validación.
service cloud.firestore {
  match /databases/{database}/documents {

    // Único administrador autorizado (D-000). Debe coincidir con VITE_ADMIN_UID.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'JnLYZuNYe8Vjuvf8TEu7rmTP1nh2';
    }

    function isInt(v) { return v is int; }
    function isNonNegInt(v) { return v is int && v >= 0; }
    function isText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optNonNegInt(v) { return v == null || isNonNegInt(v); }

    // Deniega todo por defecto.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- Configuración
    match /settings/{docId} {
      allow read: if isAdmin() && docId == 'general';
      allow create, update: if isAdmin() && docId == 'general' && validSettings(request.resource.data);
      allow delete: if false;
    }

    function validSettings(d) {
      return d.keys().hasOnly(['businessName', 'globalMarkupBp', 'roundingStep', 'defaultMinStock',
          'nearMinFactorBp', 'targetStockFactorBp', 'supplierLeadDays', 'safetyDays',
          'discountCapBp', 'reportEmail', 'updatedAt'])
        && (!('businessName' in d) || isText(d.businessName, 1, 80))
        && (!('globalMarkupBp' in d) || (isNonNegInt(d.globalMarkupBp) && d.globalMarkupBp <= 100000))
        && (!('roundingStep' in d) || d.roundingStep in [50, 100, 500, 1000])
        && (!('defaultMinStock' in d) || isNonNegInt(d.defaultMinStock))
        && (!('nearMinFactorBp' in d) || (isInt(d.nearMinFactorBp) && d.nearMinFactorBp >= 10000))
        && (!('targetStockFactorBp' in d) || (isInt(d.targetStockFactorBp) && d.targetStockFactorBp >= 10000))
        && (!('supplierLeadDays' in d) || isNonNegInt(d.supplierLeadDays))
        && (!('safetyDays' in d) || isNonNegInt(d.safetyDays))
        && (!('discountCapBp' in d) || (isNonNegInt(d.discountCapBp) && d.discountCapBp <= 10000))
        && (!('reportEmail' in d) || d.reportEmail == null || isText(d.reportEmail, 3, 120))
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // ---------------------------------------------------------------- Categorías (Fase 2)
    // No se borran: se desactivan.
    match /categories/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validCategory(request.resource.data);
      allow delete: if false;
    }

    function validCategory(d) {
      return d.keys().hasOnly(['name', 'icon', 'active', 'sortOrder'])
        && isText(d.name, 1, 40)
        && isText(d.icon, 1, 30)
        && d.active is bool
        && isInt(d.sortOrder);
    }

    // ---------------------------------------------------------------- Productos (Fase 2)
    // Stock nunca negativo. En la Fase 2 el stock nace en 0 y no se edita desde el catálogo;
    // el costo solo se edita a mano mientras no haya stock (D-105). No se borran (se desactivan).
    match /products/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validProduct(request.resource.data)
        && request.resource.data.stock == 0
        && request.resource.data.get('lastMovementId', null) == null;
      // Dos caminos de edición:
      //  1) Catálogo: no toca stock ni último movimiento; el costo solo si no hay stock.
      //  2) Inventario (R-INV-01): stock y costo cambian SOLO junto a un movimiento nuevo que cuadra.
      allow update: if isAdmin() && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (catalogEdit(id) || inventoryEdit(id));
      allow delete: if false;
    }

    function catalogEdit(id) {
      return request.resource.data.stock == resource.data.stock
        && request.resource.data.get('lastMovementId', null) == resource.data.get('lastMovementId', null)
        && (request.resource.data.avgCost == resource.data.avgCost || resource.data.stock == 0);
    }

    function inventoryEdit(id) {
      let movId = request.resource.data.get('lastMovementId', null);
      let movPath = /databases/$(database)/documents/inventoryMovements/$(movId);
      let mov = getAfter(movPath).data;
      return movId is string
        && movId != resource.data.get('lastMovementId', null)
        && !exists(movPath)
        && mov.productId == id
        && mov.stockBefore == resource.data.stock
        && mov.stockAfter == request.resource.data.stock
        && mov.avgCostBefore == resource.data.avgCost
        && mov.avgCostAfter == request.resource.data.avgCost;
    }

    function validProduct(d) {
      return d.keys().hasOnly(['name', 'description', 'categoryId', 'unit', 'stock', 'minStock',
          'avgCost', 'lastPurchaseCost', 'salePrice', 'pricingMode', 'markupBp', 'active',
          'lastMovementId', 'createdAt', 'updatedAt'])
        && isText(d.name, 1, 80)
        && d.description is string && d.description.size() <= 300
        && isText(d.categoryId, 1, 60)
        && d.unit in ['unidad', 'botella', 'media botella', 'lata', 'paquete', 'vaso', 'otro']
        && isNonNegInt(d.stock)
        && isNonNegInt(d.minStock)
        && isNonNegInt(d.avgCost)
        && isNonNegInt(d.lastPurchaseCost)
        && isNonNegInt(d.salePrice)
        && d.pricingMode in ['auto', 'manual']
        && (d.markupBp == null || (isNonNegInt(d.markupBp) && d.markupBp <= 1000000))
        && d.active is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    // ---------------------------------------------------------------- Movimientos (Fase 3)
    // Inmutables. Cada uno debe coincidir con el estado real del producto antes y después
    // del commit, y el producto debe apuntar a él (lastMovementId). Stock nunca negativo.
    match /inventoryMovements/{movId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validMovement(movId, request.resource.data);
      allow update, delete: if false;
    }

    function validMovement(movId, d) {
      let productPath = /databases/$(database)/documents/products/$(d.productId);
      let before = get(productPath).data;
      let after = getAfter(productPath).data;
      return d.keys().hasOnly(['productId', 'productName', 'type', 'qty', 'stockBefore',
          'stockAfter', 'avgCostBefore', 'avgCostAfter', 'unitCost', 'sourceType', 'sourceId',
          'reason', 'businessDate', 'uid', 'createdAt'])
        && isText(d.productId, 1, 60)
        && d.productName is string
        && d.type in ['entrada_inicial', 'entrada_manual', 'entrada_compra', 'venta',
          'cancelacion_item', 'anulacion_venta', 'merma', 'danado', 'vencido', 'cortesia',
          'consumo_propio', 'ajuste_positivo', 'ajuste_negativo', 'conteo']
        && isInt(d.qty) && d.qty != 0
        && signMatches(d.type, d.qty)
        && isNonNegInt(d.stockBefore) && isNonNegInt(d.stockAfter)
        && d.stockAfter == d.stockBefore + d.qty
        && isNonNegInt(d.avgCostBefore) && isNonNegInt(d.avgCostAfter) && isNonNegInt(d.unitCost)
        && d.sourceType in ['ajuste', 'conteo', 'venta', 'compra']
        && isText(d.sourceId, 1, 120)
        && (d.reason == null || isText(d.reason, 3, 200))
        && (!reasonRequired(d.type) || d.reason != null)
        && d.businessDate is string && d.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.uid == request.auth.uid
        && d.createdAt == request.time
        && before.stock == d.stockBefore
        && after.stock == d.stockAfter
        && after.lastMovementId == movId
        // Fase 4: ventas y cancelaciones solo desde una cuenta, con la línea que les corresponde.
        && ((d.type in ['venta', 'cancelacion_item']) == (d.sourceType == 'venta'))
        && (d.sourceType != 'venta' || saleMovementOk(movId, d));
    }

    // R-VEN-03 / R-VEN-05: `sale_{orderId}_{lineId}` y `cancel_{orderId}_{lineId}_{opId}`.
    // Venta y cancelación no cambian el costo promedio.
    function saleMovementOk(movId, d) {
      let parts = movId.split('_');
      let orderPath = /databases/$(database)/documents/orders/$(d.sourceId);
      let line = getAfter(orderPath).data.items[parts[2]];
      return parts.size() >= 3
        && parts[1] == d.sourceId
        && line.productId == d.productId
        && d.avgCostAfter == d.avgCostBefore
        && ((d.type == 'venta' && parts.size() == 3 && parts[0] == 'sale' && line.qty == -d.qty)
          || (d.type == 'cancelacion_item' && parts.size() == 4 && parts[0] == 'cancel'
            && line.lastCancelId == parts[3]
            && line.cancelledQty - get(orderPath).data.items[parts[2]].cancelledQty == d.qty));
    }

    function signMatches(type, qty) {
      return type == 'conteo'
        || (type in ['entrada_inicial', 'entrada_manual', 'entrada_compra', 'cancelacion_item',
              'anulacion_venta', 'ajuste_positivo'] && qty > 0)
        || (type in ['venta', 'merma', 'danado', 'vencido', 'cortesia', 'consumo_propio',
              'ajuste_negativo'] && qty < 0);
    }

    function reasonRequired(type) {
      return type in ['merma', 'danado', 'vencido', 'cortesia', 'consumo_propio',
        'ajuste_negativo', 'ajuste_positivo', 'conteo'];
    }

    // ================================================================ Fase 4 (D-217)

    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }

    // ---------------------------------------------------------------- Contadores
    // Nacen en 0. `orders` solo sube de a 1; `cashSessions` sube al abrir una caja y guarda
    // cuál está abierta (R-PAG-07: una sola). El cierre llega en la Fase 5.
    match /counters/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && ((id == 'orders' && request.resource.data.keys().hasOnly(['last'])
              && request.resource.data.last == 0)
          || (id == 'cashSessions' && request.resource.data.keys().hasOnly(['last', 'openSessionId'])
              && request.resource.data.last == 0 && request.resource.data.openSessionId == null)
          || (id == 'inventoryReview' && validReview(request.resource.data)
              && request.resource.data.inProgressId == null));
      allow update: if isAdmin()
        && ((id == 'orders' && request.resource.data.keys().hasOnly(['last'])
              && request.resource.data.last == resource.data.last + 1)
          || (id == 'cashSessions' && (cashOpening() || cashClosing()))
          || (id == 'inventoryReview' && validReview(request.resource.data)
              && reviewTransition(resource.data, request.resource.data)));
      allow delete: if false;
    }

    // Fase 6 (R-INV-11, D-221): revisión de inventario cada N meses.
    function validReview(d) {
      return d.keys().hasOnly(['periodMonths', 'lastReviewDate', 'scheduledDate', 'inProgressId',
          'startedAt', 'updatedAt'])
        && isInt(d.periodMonths) && d.periodMonths >= 1 && d.periodMonths <= 12
        && isDate(d.lastReviewDate)
        && (d.scheduledDate == null || isDate(d.scheduledDate))
        && (d.inProgressId == null || isText(d.inProgressId, 1, 60))
        && (d.inProgressId == null ? d.startedAt == null : d.startedAt is timestamp)
        && d.updatedAt == request.time;
    }

    // Empezar solo con la caja cerrada; una revisión en curso no se reemplaza por otra.
    function reviewTransition(a, b) {
      return (a.inProgressId == null && b.inProgressId != null)
          ? (b.startedAt == request.time
              && get(docPath('counters', 'cashSessions')).data.openSessionId == null)
          : (a.inProgressId == null || b.inProgressId == null || b.inProgressId == a.inProgressId);
    }

    // Fase 5 (R-PAG-06): al cerrar, la caja abierta queda cerrada y el contador sin caja.
    function cashClosing() {
      let b = request.resource.data;
      return b.keys().hasOnly(['last', 'openSessionId'])
        && b.last == resource.data.last
        && resource.data.openSessionId != null
        && b.openSessionId == null
        && getAfter(docPath('cashSessions', resource.data.openSessionId)).data.status == 'cerrada';
    }

    function cashOpening() {
      let b = request.resource.data;
      return b.keys().hasOnly(['last', 'openSessionId'])
        && resource.data.openSessionId == null
        && b.last == resource.data.last + 1
        && isText(b.openSessionId, 1, 60)
        && getAfter(docPath('cashSessions', b.openSessionId)).data.number == b.last;
    }

    // ---------------------------------------------------------------- Caja (apertura y cierre)
    match /cashSessions/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validCashOpen(id, request.resource.data);
      allow update: if isAdmin() && cashClose(id, resource.data, request.resource.data);
      allow delete: if false;
    }

    // R-PAG-06: conteo obligatorio; diferencia = contado − esperado, con motivo si no es 0.
    // Definitivo: una caja cerrada no se vuelve a tocar.
    function cashClose(id, a, b) {
      let c = docPath('counters', 'cashSessions');
      return a.status == 'abierta'
        && b.diff(a).affectedKeys().hasOnly(['status', 'closedAt', 'closedBy', 'expectedCash',
          'countedCash', 'difference', 'differenceReason', 'summary'])
        && b.status == 'cerrada'
        && b.closedAt == request.time
        && b.closedBy == request.auth.uid
        && isInt(b.expectedCash)
        && isNonNegInt(b.countedCash)
        && b.difference == b.countedCash - b.expectedCash
        && (b.difference == 0 ? b.differenceReason == null : isText(b.differenceReason, 3, 300))
        && b.summary is map
        && get(c).data.openSessionId == id
        && getAfter(c).data.openSessionId == null;
    }

    // R-INV-11: no se abre caja mientras hay una revisión de inventario en curso.
    function noReviewInProgress() {
      let r = docPath('counters', 'inventoryReview');
      return !exists(r) || get(r).data.inProgressId == null;
    }

    function validCashOpen(id, d) {
      let c = docPath('counters', 'cashSessions');
      return d.keys().hasOnly(['number', 'businessDate', 'status', 'openingBalance', 'openedAt',
          'openedBy', 'closedAt'])
        && d.status == 'abierta'
        && isInt(d.number)
        && d.number == getAfter(c).data.last
        && getAfter(c).data.openSessionId == id
        && get(c).data.openSessionId == null
        && noReviewInProgress()
        && isNonNegInt(d.openingBalance) && d.openingBalance <= 20000000
        && isDate(d.businessDate)
        && d.openedAt == request.time
        && d.openedBy == request.auth.uid
        && d.closedAt == null;
    }

    // ---------------------------------------------------------------- Mesas
    // ID `mesa-{número}`. No se borran. La mesa y su cuenta deben cuadrar (R-VEN-06).
    match /tables/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validTable(request.resource.data)
        && id == 'mesa-' + string(request.resource.data.number)
        && request.resource.data.currentOrderId == null
        && request.resource.data.status in ['disponible', 'fuera_servicio'];
      allow update: if isAdmin() && validTable(request.resource.data)
        && request.resource.data.number == resource.data.number
        && tableStateOk(id, resource.data, request.resource.data);
      allow delete: if false;
    }

    function validTable(d) {
      return d.keys().hasOnly(['name', 'number', 'status', 'currentOrderId', 'active', 'sortOrder'])
        && isText(d.name, 1, 40)
        && isInt(d.number) && d.number > 0 && d.number <= 999
        && d.status in ['disponible', 'ocupada', 'por_cobrar', 'fuera_servicio']
        && (d.currentOrderId == null || isText(d.currentOrderId, 1, 60))
        && d.active is bool
        && isInt(d.sortOrder);
    }

    function tableStatusOf(orderStatus) {
      return orderStatus == 'abierta' ? 'ocupada'
        : (orderStatus == 'por_cobrar' ? 'por_cobrar' : 'no_aplica');
    }

    function tableStateOk(id, a, b) {
      return b.currentOrderId == null
        ? (b.status in ['disponible', 'fuera_servicio']
          && (a.currentOrderId == null || orderLeftTable(a.currentOrderId, id)))
        : (b.active == true
          && getAfter(docPath('orders', b.currentOrderId)).data.tableId == id
          && b.status == tableStatusOf(getAfter(docPath('orders', b.currentOrderId)).data.status)
          && (a.currentOrderId == b.currentOrderId
            || (a.currentOrderId == null && a.status == 'disponible' && a.active == true)));
    }

    function orderLeftTable(orderId, tableId) {
      let o = getAfter(docPath('orders', orderId)).data;
      return o.tableId != tableId || !(o.status in ['abierta', 'por_cobrar']);
    }

    // ---------------------------------------------------------------- Cuentas
    // Ítems en un mapa por lineId (D-217). Cada cambio toca a lo sumo una línea (`lastLineId`):
    // agregarla (con su movimiento `venta`) o cancelar parte de ella. Sin descuentos en V1.
    match /orders/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validOrder(request.resource.data)
        && orderCreate(id, request.resource.data);
      allow update: if isAdmin() && validOrder(request.resource.data)
        && orderUpdate(id, resource.data, request.resource.data);
      allow delete: if false;
    }

    function validOrder(d) {
      return d.keys().hasOnly(['number', 'type', 'tableId', 'tableName', 'label', 'status',
          'cashSessionId', 'businessDate', 'items', 'lastLineId', 'subtotal', 'total', 'paidTotal',
          'tipTotal', 'balance', 'lastPaymentId', 'uid', 'openedAt', 'closedAt', 'updatedAt'])
        && isInt(d.number) && d.number > 0
        && d.type in ['mesa', 'barra']
        && (d.type == 'mesa'
          ? (isText(d.tableId, 1, 60) && isText(d.tableName, 1, 40))
          : (d.tableId == null && d.tableName == null))
        && (d.label == null || isText(d.label, 1, 40))
        && d.status in ['abierta', 'por_cobrar', 'cerrada_sin_consumo', 'pagada']
        && isText(d.cashSessionId, 1, 60)
        && isDate(d.businessDate)
        && d.items is map
        && (d.lastLineId == null || isText(d.lastLineId, 1, 60))
        && isNonNegInt(d.subtotal) && d.total == d.subtotal
        // Fase 5: saldo = total − pagado, nunca negativo (sin propinas ni reembolsos, D-219).
        && isNonNegInt(d.paidTotal) && d.tipTotal == 0
        && isNonNegInt(d.balance) && d.balance == d.total - d.paidTotal
        && (d.get('lastPaymentId', null) == null || isText(d.lastPaymentId, 1, 60))
        && d.uid == request.auth.uid
        && d.openedAt is timestamp
        && (d.closedAt == null || d.closedAt is timestamp)
        && d.updatedAt == request.time;
    }

    function orderCreate(id, d) {
      let oc = docPath('counters', 'orders');
      return d.status == 'abierta' && d.items.size() == 0 && d.subtotal == 0
        && d.lastLineId == null && d.paidTotal == 0 && d.get('lastPaymentId', null) == null
        && d.openedAt == request.time && d.closedAt == null
        // D-110: la cuenta pertenece a la caja abierta.
        && d.cashSessionId == get(docPath('counters', 'cashSessions')).data.openSessionId
        && d.number == get(oc).data.last + 1
        && getAfter(oc).data.last == d.number
        && (d.type == 'barra' || tableTaken(id, d));
    }

    function tableTaken(id, d) {
      let before = get(docPath('tables', d.tableId)).data;
      return before.status == 'disponible' && before.active == true
        && before.name == d.tableName
        && getAfter(docPath('tables', d.tableId)).data.currentOrderId == id;
    }

    function orderUpdate(id, a, b) {
      let diff = b.items.diff(a.items);
      let paying = b.get('lastPaymentId', null) != a.get('lastPaymentId', null);
      return a.status in ['abierta', 'por_cobrar']
        && b.number == a.number && b.cashSessionId == a.cashSessionId
        && b.businessDate == a.businessDate && b.openedAt == a.openedAt
        && (paying
          ? (diff.affectedKeys().size() == 0 && payOrder(id, a, b))
          : (b.paidTotal == a.paidTotal
            && (diff.affectedKeys().size() == 0
              ? (b.lastLineId == a.lastLineId && b.subtotal == a.subtotal && orderMeta(a, b))
              : (diff.affectedKeys().hasOnly([b.lastLineId])
                && b.type == a.type && b.tableId == a.tableId && b.label == a.label
                && b.closedAt == null
                && (diff.addedKeys().size() == 1
                  ? addLine(id, a, b, b.lastLineId)
                  : cancelLine(id, a, b, b.lastLineId))))))
        && tableFollows(id, a, b);
    }

    // R-PAG-02 / R-VEN-08: un pago nuevo en el mismo commit; con saldo 0 la cuenta queda pagada.
    function payOrder(id, a, b) {
      let payPath = docPath('payments', b.lastPaymentId);
      let p = getAfter(payPath).data;
      return isText(b.lastPaymentId, 1, 60)
        && b.type == a.type && b.tableId == a.tableId && b.label == a.label
        && b.lastLineId == a.lastLineId && b.subtotal == a.subtotal
        && !exists(payPath)
        && p.orderId == id
        && p.amount == b.paidTotal - a.paidTotal
        && (b.balance == 0
          ? (b.status == 'pagada' && b.closedAt == request.time)
          : (b.status == a.status && b.closedAt == null));
    }

    function validLine(l) {
      return l.keys().hasOnly(['productId', 'nameSnap', 'categoryIdSnap', 'unitPrice',
          'unitCostSnap', 'qty', 'cancelledQty', 'lostQty', 'lastCancelId', 'addedAt'])
        && isText(l.productId, 1, 60)
        && l.nameSnap is string && l.categoryIdSnap is string
        && isNonNegInt(l.unitPrice) && isNonNegInt(l.unitCostSnap)
        && isInt(l.qty) && l.qty > 0
        && isNonNegInt(l.cancelledQty) && isNonNegInt(l.lostQty)
        && l.cancelledQty + l.lostQty <= l.qty
        && (l.lastCancelId == null || (l.lastCancelId is string
          && l.lastCancelId.matches('^[A-Za-z0-9-]{1,40}$')))
        && l.addedAt is timestamp;
    }

    // R-VEN-03: precio y costo congelados del producto, y su movimiento `venta` en el mismo commit.
    function addLine(id, a, b, lid) {
      let l = b.items[lid];
      let p = get(docPath('products', l.productId)).data;
      let movPath = docPath('inventoryMovements', 'sale_' + id + '_' + lid);
      return lid.matches('^[A-Za-z0-9-]{1,40}$')
        && validLine(l)
        && l.cancelledQty == 0 && l.lostQty == 0 && l.lastCancelId == null
        && l.addedAt == request.time
        && p.active == true && p.salePrice > 0
        && l.unitPrice == p.salePrice && l.unitCostSnap == p.avgCost
        && l.nameSnap == p.name && l.categoryIdSnap == p.categoryId
        && !exists(movPath)
        && getAfter(movPath).data.qty == -l.qty
        && b.subtotal == a.subtotal + l.unitPrice * l.qty
        // R-VEN-02: agregar productos regresa la cuenta a "abierta".
        && b.status == 'abierta';
    }

    // R-VEN-05 (D-217): devolver al stock (con movimiento) o pérdida (sin movimiento).
    function cancelLine(id, a, b, lid) {
      let o = a.items[lid];
      let n = b.items[lid];
      let dc = n.cancelledQty - o.cancelledQty;
      let dl = n.lostQty - o.lostQty;
      let movPath = docPath('inventoryMovements',
        'cancel_' + id + '_' + lid + '_' + string(n.lastCancelId));
      return validLine(n)
        && n.productId == o.productId && n.nameSnap == o.nameSnap
        && n.categoryIdSnap == o.categoryIdSnap
        && n.unitPrice == o.unitPrice && n.unitCostSnap == o.unitCostSnap
        && n.qty == o.qty && n.addedAt == o.addedAt
        && dc >= 0 && dl >= 0 && dc + dl > 0 && (dc == 0 || dl == 0)
        && n.lastCancelId is string && n.lastCancelId != o.lastCancelId
        && b.subtotal == a.subtotal - o.unitPrice * (dc + dl)
        && b.status == a.status
        && (dc == 0 || (!exists(movPath) && getAfter(movPath).data.qty == dc));
    }

    // Sin tocar líneas: pedir cuenta / reabrir, cambiar nombre, mover de mesa o cerrar sin consumo.
    function orderMeta(a, b) {
      return (b.type == a.type || (a.type == 'barra' && b.type == 'mesa'))
        && (b.status in ['abierta', 'por_cobrar']
          ? b.closedAt == null
          : (b.status == 'cerrada_sin_consumo' && a.subtotal == 0
            && b.closedAt == request.time && b.tableId == a.tableId));
    }

    // R-VEN-06: la mesa nueva queda con la cuenta; la anterior se libera.
    function tableFollows(id, a, b) {
      let open = b.status in ['abierta', 'por_cobrar'];
      return (b.type == 'barra' || !open || tableHolds(id, b))
        && (a.type == 'barra' || (open && b.tableId == a.tableId) || tableReleased(id, a.tableId));
    }

    function tableHolds(id, b) {
      let t = getAfter(docPath('tables', b.tableId)).data;
      return t.currentOrderId == id && t.status == tableStatusOf(b.status);
    }

    function tableReleased(id, tableId) {
      return getAfter(docPath('tables', tableId)).data.currentOrderId != id;
    }

    // ================================================================ Fase 5 (D-219)

    // ---------------------------------------------------------------- Pagos
    // Inmutables salvo la corrección del medio (D-219) mientras su caja siga abierta.
    // Sin propinas. Efectivo: recibido >= abonado y cambio = la diferencia. Transferencia: canal.
    match /payments/{pid} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validPayment(pid, request.resource.data);
      allow update: if isAdmin() && paymentFix(resource.data, request.resource.data);
      allow delete: if false;
    }

    function paymentShape(d) {
      return d.keys().hasOnly(['orderId', 'cashSessionId', 'businessDate', 'method', 'channel',
          'amount', 'tendered', 'change', 'reference', 'kind', 'uid', 'createdAt', 'correctedAt',
          'correctedFrom'])
        && d.kind == 'pago'
        && isInt(d.amount) && d.amount > 0
        && (d.method == 'efectivo'
          ? (d.channel == null && isInt(d.tendered) && d.tendered >= d.amount
            && d.change == d.tendered - d.amount)
          : (d.method == 'transferencia'
            && d.channel in ['nequi', 'daviplata', 'banco', 'breb_qr_llave', 'otro']
            && d.tendered == null && d.change == 0))
        && (d.reference == null || isText(d.reference, 1, 60));
    }

    function validPayment(pid, d) {
      let o = getAfter(docPath('orders', d.orderId)).data;
      return pid.matches('^[A-Za-z0-9-]{1,40}$')
        && paymentShape(d)
        && isText(d.orderId, 1, 60)
        // La cuenta es de la caja abierta y apunta a este pago (que cuadra con su pagado).
        && d.cashSessionId == get(docPath('counters', 'cashSessions')).data.openSessionId
        && o.cashSessionId == d.cashSessionId
        && o.businessDate == d.businessDate
        && o.lastPaymentId == pid
        && d.uid == request.auth.uid
        && d.createdAt == request.time
        && d.correctedAt == null && d.correctedFrom == null;
    }

    function paymentFix(a, b) {
      return paymentShape(b)
        && b.diff(a).affectedKeys().hasOnly(['method', 'channel', 'tendered', 'change',
          'reference', 'correctedAt', 'correctedFrom'])
        && (b.method != a.method || b.channel != a.channel)
        && b.change == 0
        && b.correctedAt == request.time
        && b.correctedFrom == {'method': a.method, 'channel': a.channel}
        && a.cashSessionId == get(docPath('counters', 'cashSessions')).data.openSessionId;
    }

    // ---------------------------------------------------------------- Movimientos de caja
    // Inmutables, con motivo, solo en la caja abierta. Gastos y pagos a proveedores: Fases 7-8.
    match /cashMovements/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validCashMovement(request.resource.data);
      allow update, delete: if false;
    }

    function validCashMovement(d) {
      return d.keys().hasOnly(['sessionId', 'businessDate', 'type', 'amount', 'reason', 'refType',
          'refId', 'uid', 'createdAt'])
        && d.sessionId == get(docPath('counters', 'cashSessions')).data.openSessionId
        && d.businessDate == get(docPath('cashSessions', d.sessionId)).data.businessDate
        && d.type in ['entrada_extra', 'retiro_dueno', 'correccion']
        && isInt(d.amount) && d.amount != 0
        && (d.type != 'entrada_extra' || d.amount > 0)
        && (d.type != 'retiro_dueno' || d.amount < 0)
        && isText(d.reason, 3, 200)
        && d.refType == null && d.refId == null
        && d.uid == request.auth.uid
        && d.createdAt == request.time;
    }

    // ---------------------------------------------------------------- Agregados diarios
    // D-204: se suman con increment() en las transacciones de cobro. Ventas y costo nunca negativos.
    match /dailyStats/{date} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isDate(date)
        && validDailyStats(date, request.resource.data);
      allow delete: if false;
    }

    function validDailyStats(date, d) {
      return d.keys().hasOnly(['businessDate', 'salesGross', 'cogs', 'ordersCount', 'collected',
          'orderLosses', 'invLosses', 'invGains', 'byMethod', 'byChannel', 'byLossType', 'byHour',
          'byProduct', 'byCategory', 'updatedAt'])
        && d.businessDate == date
        && isNonNegInt(d.get('salesGross', 0))
        && isNonNegInt(d.get('cogs', 0))
        && isNonNegInt(d.get('ordersCount', 0))
        && isNonNegInt(d.get('collected', 0))
        && isNonNegInt(d.get('orderLosses', 0))
        && isNonNegInt(d.get('invLosses', 0))
        && isNonNegInt(d.get('invGains', 0))
        && d.get('byLossType', {}) is map
        && d.get('byHour', {}) is map
        && d.get('byMethod', {}) is map
        && d.get('byChannel', {}) is map
        && d.get('byProduct', {}) is map
        && d.get('byCategory', {}) is map
        && d.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- Historial de precios
    // Inmutable: solo se crea, y solo para productos que existen (o se crean en el mismo batch).
    match /priceHistory/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validPriceHistory(request.resource.data)
        && existsAfter(/databases/$(database)/documents/products/$(request.resource.data.productId));
      allow update, delete: if false;
    }

    function validPriceHistory(d) {
      return d.keys().hasOnly(['productId', 'field', 'oldValue', 'newValue', 'source', 'reason', 'at'])
        && isText(d.productId, 1, 60)
        && d.field in ['salePrice', 'avgCost', 'markupBp']
        && optNonNegInt(d.oldValue)
        && optNonNegInt(d.newValue)
        && d.source in ['creacion', 'manual', 'recalculo', 'importacion', 'recepcion', 'ajuste']
        && (d.reason == null || isText(d.reason, 1, 200))
        && d.at == request.time;
    }

    // ---------------------------------------------------------------- Auditoría
    // Inmutable. El UID debe ser el de quien escribe y la fecha la del servidor.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAudit(request.resource.data);
      allow update, delete: if false;
    }

    function validAudit(d) {
      return d.keys().hasOnly(['action', 'entity', 'entityId', 'summary', 'before', 'after',
          'reason', 'uid', 'at'])
        && isText(d.action, 1, 40)
        && isText(d.entity, 1, 40)
        && isText(d.entityId, 1, 120)
        && isText(d.summary, 1, 300)
        && (d.before == null || d.before is map)
        && (d.after == null || d.after is map)
        && (d.reason == null || isText(d.reason, 1, 300))
        && d.uid == request.auth.uid
        && d.at == request.time;
    }
  }
}
