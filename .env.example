# Copia este archivo a .env.local (no se sube a git).
# true = emuladores locales (proyecto demo-bar-kmilo); false = proyecto real kmilo-bar:
VITE_USE_EMULATORS=false

# Producción / proyecto real (configuración PÚBLICA de la app web de Firebase).
# Nunca pongas aquí cuentas de servicio ni claves privadas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# UID del usuario administrador en Firebase Auth (el mismo que va en firestore.rules).
VITE_ADMIN_UID=
